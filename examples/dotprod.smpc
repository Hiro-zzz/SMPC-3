// ============================================================================
//  СКАЛЯРНОЕ ПРОИЗВЕДЕНИЕ
// ============================================================================
//
// Отдельной операции @dot нет и не будет: она раскладывается на две уже
// существующие. Поэлементное умножение, затем свёртка суммой.
//
//   a = [1, 2, 3, 4]
//   b = [10, 20, 30, 40]
//   a . b = 10 + 40 + 90 + 160 = 300
//
// Длина вектора: |a| = sqrt(1 + 4 + 9 + 16) = sqrt(30) ~ 5.477.

[#arena:0]  *&a<f32:4> -> @alloc => $ra;
[#arena:0]  *&b<f32:4> -> @alloc => $rb;

1.0 => *&a[0];   2.0 => *&a[1];   3.0 => *&a[2];   4.0 => *&a[3];
10.0 => *&b[0];  20.0 => *&b[1];  30.0 => *&b[2];  40.0 => *&b[3];

// Скалярное произведение
[#simd:v256]  *&a -> @mul(*&b) => *&prod<f32:4>  [!no-alias];
*&prod -> @reduce.add => $dot;

// Квадрат длины каждого вектора
[#simd:v256]  *&a -> @mul(*&a) => *&sq_a<f32:4>;
*&sq_a -> @reduce.add => $len2_a;

[#simd:v256]  *&b -> @mul(*&b) => *&sq_b<f32:4>;
*&sq_b -> @reduce.add => $len2_b;

// И сама длина: корень из квадрата
$len2_a -> @sqrt => $len_a;

// Вычитание тоже раскладывается: a + (-1)*b
[#simd:v256]  *&b -> @scale(-1.0) => *&neg_b<f32:4>  [!no-alias];
[#simd:v256]  *&a -> @add(*&neg_b) => *&diff<f32:4>  [!no-alias];

// Манхэттенское расстояние между a и b
*&diff -> @abs -> @reduce.add => $manhattan;

// Максимальное покомпонентное расхождение
*&diff -> @abs -> @reduce.max => $chebyshev;
