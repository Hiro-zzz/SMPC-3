// ============================================================================
//  РАНЖИРОВАНИЕ КАНДИДАТОВ БЕЗ ВЕТВЛЕНИЙ
// ============================================================================
//
// Задача из чат-бота: сгенерировано K ответов, надо выбрать лучший. Оценка
// складывается из трёх слагаемых, и каждое написано через min/max и условия:
//
//     topic  = min(hits, 4) / 4
//     flu    = max(0, min(1, 1 + fluency / 6))
//     len    = count/3            при count < 3
//              1                  при 3 <= count <= 14
//              max(0.3, 1 - (count-14)/20)   дальше
//     score  = topic + 0.6*flu + 0.5*len
//
// Ветвлений в языке нет. Они и не нужны: все три слагаемых кусочно-линейны, а
// кусочно-линейное собирается из relu. Один и тот же приём уже рисует
// ступеньку в bars.smpc:
//
//     clamp01(x) = relu(x) - relu(x - 1)     0 при x<=0, x при 0<x<1, 1 при x>=1
//
// Вычитания в языке тоже нет, поэтому «минус» — это @scale(-1.0) и @add.
// Отсюда весь объём: каждый clamp01 стоит трёх инструкций. Взамен K кандидатов
// считаются разом, одним проходом на стадию, и ни одного перехода.

// --- Вход: по одному числу на кандидата --------------------------------------
[#arena:0]  *&H<f32:8> -> @load => *&H;   // сколько слов попало в тему
[#arena:0]  *&F<f32:8> -> @load => *&F;   // связность по модели, логвероятность
[#arena:0]  *&C<f32:8> -> @load => *&C;   // длина ответа в словах

// --- Константы, они же операнды сдвига ---------------------------------------
// @add берёт тензор, а не скаляр: прибавить число можно только тензором,
// заполненным этим числом.
[#arena:0]  *&M1<f32:8>  -> @fill(-1.0)  => *&M1;
[#arena:0]  *&M14<f32:8> -> @fill(-14.0) => *&M14;
[#arena:0]  *&P1<f32:8>  -> @fill(1.0)   => *&P1;

// --- topic = clamp01(H / 4) ---------------------------------------------------
[#arena:0]  *&Ta<f32:8> -> @alloc => *&Ta;
[#arena:0]  *&Tb<f32:8> -> @alloc => *&Tb;
[#arena:0]  *&T<f32:8>  -> @alloc => *&T;

[#simd:v256]  *&H -> @scale(0.25) -> @relu => *&Ta  [!no-alias];
[#simd:v256]  *&H -> @scale(0.25) -> @add(*&M1) -> @relu -> @scale(-1.0) => *&Tb  [!no-alias];
[#simd:v256]  *&Ta -> @add(*&Tb) => *&T  [!no-alias];

// --- flu = clamp01(F/6 + 1) ---------------------------------------------------
[#arena:0]  *&Fa<f32:8> -> @alloc => *&Fa;
[#arena:0]  *&Fb<f32:8> -> @alloc => *&Fb;
[#arena:0]  *&U<f32:8>  -> @alloc => *&U;

[#simd:v256]  *&F -> @scale(0.1666666667) -> @add(*&P1) -> @relu => *&Fa  [!no-alias];
[#simd:v256]  *&F -> @scale(0.1666666667) -> @relu -> @scale(-1.0) => *&Fb  [!no-alias];
[#simd:v256]  *&Fa -> @add(*&Fb) => *&U  [!no-alias];

// --- len = clamp01(C/3) - 0.7 * clamp01((C-14)/14) ----------------------------
// Спад ниже 0.3 не опускается, и это не отдельная ветка: 0.7*clamp01((c-14)/14)
// растёт ровно как (c-14)/20 и упирается в 0.7 там же, где исходная формула
// упирается в 0.3 — при c = 28. Две записи совпадают тождественно.
[#arena:0]  *&La<f32:8> -> @alloc => *&La;
[#arena:0]  *&Lb<f32:8> -> @alloc => *&Lb;
[#arena:0]  *&Lc<f32:8> -> @alloc => *&Lc;
[#arena:0]  *&Ld<f32:8> -> @alloc => *&Ld;
[#arena:0]  *&L<f32:8>  -> @alloc => *&L;

[#simd:v256]  *&C -> @scale(0.3333333333) -> @relu => *&La  [!no-alias];
[#simd:v256]  *&C -> @scale(0.3333333333) -> @add(*&M1) -> @relu -> @scale(-1.0) => *&Lb  [!no-alias];
[#simd:v256]  *&La -> @add(*&Lb) => *&Lc  [!no-alias];

[#simd:v256]  *&C -> @add(*&M14) -> @scale(0.0714285714) -> @relu => *&La  [!no-alias];
[#simd:v256]  *&C -> @add(*&M14) -> @scale(0.0714285714) -> @add(*&M1) -> @relu -> @scale(-1.0) => *&Lb  [!no-alias];
[#simd:v256]  *&La -> @add(*&Lb) -> @scale(-0.7) => *&Ld  [!no-alias];

[#simd:v256]  *&Lc -> @add(*&Ld) => *&L  [!no-alias];

// --- score = topic + 0.6*flu + 0.5*len ----------------------------------------
[#arena:0]  *&Sa<f32:8> -> @alloc => *&Sa;
[#arena:0]  *&S<f32:8>  -> @alloc => *&S;

[#simd:v256]  *&U -> @scale(0.6) -> @add(*&T) => *&Sa  [!no-alias];
[#simd:v256]  *&L -> @scale(0.5) -> @add(*&Sa) => *&S  [!no-alias];

*&S -> @store => $put;
