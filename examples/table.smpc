// ============================================================================
//  ТАБЛИЦА УМНОЖЕНИЯ ОДНИМ GEMM
// ============================================================================
//
// Ни одного числа таблицы не записано руками. Задан только вектор 1..9, всё
// остальное — внешнее произведение: столбец [9,1] на строку [1,9] даёт
// матрицу [9,9], в которой T[i,j] = (i+1)*(j+1).
//
// Это ровно та операция, ради которой язык и написан, только результат уходит
// не в редукцию, а на экран.

[#arena:0]  *&col<f32:9,1> -> @alloc => $c;
1.0 => *&col[0,0];   2.0 => *&col[1,0];   3.0 => *&col[2,0];
4.0 => *&col[3,0];   5.0 => *&col[4,0];   6.0 => *&col[5,0];
7.0 => *&col[6,0];   8.0 => *&col[7,0];   9.0 => *&col[8,0];

// Строку получаем транспозицией столбца — второй раз те же числа не пишем.
*&col -> @transpose -> @pack => *&row<f32:1,9>;

// Одно матричное умножение — и таблица готова.
[#simd:v256]  *&col -> @mmul(*&row) => *&T<f32:9,9>  [!no-alias, ?strict];

// @emit.dec печатает целыми, поэтому приведение обязано быть явным:
// молча округлять за пользователя язык не станет.
*&T -> @cast.i32 => *&Ti<i32:9,9>;

// Построчно. Управляющих конструкций в языке нет — девять строк и есть цикл.
*&Ti[0, ..] -> @emit.dec => $r0;
*&Ti[1, ..] -> @emit.dec => $r1;
*&Ti[2, ..] -> @emit.dec => $r2;
*&Ti[3, ..] -> @emit.dec => $r3;
*&Ti[4, ..] -> @emit.dec => $r4;
*&Ti[5, ..] -> @emit.dec => $r5;
*&Ti[6, ..] -> @emit.dec => $r6;
*&Ti[7, ..] -> @emit.dec => $r7;
*&Ti[8, ..] -> @emit.dec => $r8;

// Сумма всей таблицы: (1+..+9)^2 = 45^2 = 2025
*&T -> @reduce.add => $total;
