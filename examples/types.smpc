// ============================================================================
//  ТИПЫ И ПРИВЕДЕНИЯ
// ============================================================================
//
// Типов пять: f32, f64, i32, u64, raw_ptr. Неявных приведений нет ни одного —
// сложить f32 с f64 нельзя, компилятор скажет E0303. Приведение только явное,
// через @cast.<тип>, и оно всегда создаёт копию: менять тип на месте значило
// бы менять размер элемента под уже выданным дескриптором.

// --- Размеры элементов видно по размеру арены -------------------------------
[#arena:0]  *&f32v<f32:8> -> @fill(1.5) => *&f32v;     //  8 x 4 =  32 байта
[#arena:1]  *&f64v<f64:8> -> @fill(1.5) => *&f64v;     //  8 x 8 =  64 байта
[#arena:2]  *&i32v<i32:8> -> @fill(7)   => *&i32v;     //  8 x 4 =  32 байта
[#arena:3]  *&u64v<u64:8> -> @fill(7)   => *&u64v;     //  8 x 8 =  64 байта

*&f32v -> @reduce.add => $sum_f32;    // 8 * 1.5 = 12
*&f64v -> @reduce.add => $sum_f64;    // 12
*&i32v -> @reduce.add => $sum_i32;    // 8 * 7 = 56
*&u64v -> @reduce.add => $sum_u64;    // 56

// --- Приведение с потерей дробной части --------------------------------------
[#arena:0]  *&frac<f32:4> -> @alloc => $fr;
 2.7 => *&frac[0];
-2.7 => *&frac[1];
 0.5 => *&frac[2];
-0.5 => *&frac[3];

// Отбрасывание к нулю, а не округление: 2.7 -> 2, -2.7 -> -2
*&frac -> @cast.i32 => *&trunc<i32:4>;
*&trunc -> @reduce.add => $sum_trunc;       // 2 + (-2) + 0 + 0 = 0

// --- Насыщение вместо неопределённого поведения -----------------------------
// Преобразование double вне диапазона целого — UB в C. Здесь оно насыщается:
// отрицательное в u64 даёт 0, а не 18446744073709551615.
[#arena:0]  *&neg<f32:2> -> @fill(-5.0) => *&neg;
*&neg -> @cast.u64 => *&clamped<u64:2>;
*&clamped -> @reduce.add => $sum_clamped;   // 0, а не мусор

// --- Расширение точности ------------------------------------------------------
// f32 хранит ~7 значащих цифр; 16777217 = 2^24 + 1 в него не влезает и
// становится 16777216. Приведение к f64 этого уже не вернёт.
[#arena:0]  *&big<f32:1> -> @fill(16777217.0) => *&big;
*&big -> @cast.f64 => *&big64<f64:1>;
*&big64 -> @reduce.add => $big_back;        // 16777216, а не 16777217

// --- Смешивать типы нельзя ---------------------------------------------------
// Раскомментируй — получишь E0303 «Несовместимые типы операндов»:
//
//   *&f32v -> @add(*&f64v) => *&mix<f32:8>;
//
// Правильный путь — привести явно:
*&f64v -> @cast.f32 => *&f64_as_f32<f32:8>;
[#simd:v256]  *&f32v -> @add(*&f64_as_f32) => *&mixed<f32:8>  [!no-alias];
*&mixed -> @reduce.add => $sum_mixed;       // 8 * 3.0 = 24
