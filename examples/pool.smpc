// ============================================================================
//  ПУЛ ИНСТАНСОВ
// ============================================================================
//
// Один и тот же модуль, поднятый в N независимых инстансах. У каждого свои
// арены, свой регистровый файл и своя рабочая память ядер — разделяемого
// изменяемого состояния между ними нет вообще, поэтому их можно раскидать по
// потокам без единого мьютекса.
//
//   smpc3 run examples/pool.smpc              один инстанс
//   smpc3 run examples/pool.smpc -n 64 -j 16  64 инстанса на 16 потоках
//
// @fill.instance — единственное, чем инстансы отличаются друг от друга изнутри
// языка. Без него N копий посчитали бы N раз одно и то же.

// --- Кто я ------------------------------------------------------------------
[#arena:0]  *&ID<f32:1> -> @fill.instance => *&ID;
*&ID -> @reduce.add => $id;

// --- Каждый инстанс считает свой кусок ---------------------------------------
// Матрицу A заполняем значением, зависящим от номера: 1 + id/16.
// Так результаты инстансов заведомо различны, и склейка данных между ними
// стала бы видна сразу.
[#arena:0]  *&SCALE<f32:1> -> @fill.instance => *&SCALE;
[#simd:v256]  *&SCALE -> @scale(0.0625) => *&frac<f32:1>  [!no-alias];
[#arena:0]  *&one<f32:1> -> @fill(1.0) => *&one;
[#simd:v256]  *&frac -> @add(*&one) => *&k<f32:1>  [!no-alias];
*&k -> @reduce.add => $coef;

[#arena:1]  *&A<f32:96,96> -> @fill(1.0) => *&A;
[#arena:1]  *&B<f32:96,96> -> @fill(2.0) => *&B;

[#simd:v256]  *&A -> @mmul(*&B) => *&C<f32:96,96>  [!no-alias, ?strict];

// Каждый элемент C равен 96 * 1 * 2 = 192; всего 96*96 элементов.
// Сумма одинакова у всех инстансов — по ней и видно, что гонки нет.
*&C -> @reduce.add => $sum;

// А это у каждого своё.
*&C -> @reduce.max => $peak;
