// ============================================================================
//  КАЛЬКУЛЯТОР, ВЫЧИСЛЯЮЩИЙ СВОЙ ДИСПЛЕЙ
// ============================================================================
//
// Ни один символ картинки не записан руками. Задан ровно один вектор — индексы
// 0..7. Всё остальное, включая форму столбиков и коды символов, получается
// матричными операциями.
//
// Идея. Нужна маска M[i,j] = 1, если j < V[i], и 0 иначе. Ветвлений в языке
// нет, но они и не нужны:
//
//     relu(x) - relu(x - 1)  =  0 при x <= 0
//                               1 при x >= 1
//
// Для целых x это ровно ступенька. Подставляем x = V[i] - j — получаем маску
// без единого условного перехода.
//
// Дальше маска превращается в коды символов линейно:
//     код = 32 + (9608 - 32) * маска
// где 32 — пробел, 9608 — U+2588 FULL BLOCK.

// --- Единственные заданные данные: индексы -----------------------------------
[#arena:0]  *&I<f32:8,1> -> @alloc => $i;
0.0 => *&I[0,0];  1.0 => *&I[1,0];  2.0 => *&I[2,0];  3.0 => *&I[3,0];
4.0 => *&I[4,0];  5.0 => *&I[5,0];  6.0 => *&I[6,0];  7.0 => *&I[7,0];

// Те же индексы строкой — транспозиция, а не повторный набор.
*&I -> @transpose -> @pack => *&J<f32:1,8>;

// --- Высоты столбиков: V = i*(8-i)/2 ----------------------------------------
// Раскрываем как (8i - i*i)/2, потому что вычитания в языке нет: есть
// прибавление отрицательного.
[#simd:v256]  *&I -> @scale(8.0)   => *&I8<f32:8,1>   [!no-alias];
[#simd:v256]  *&I -> @mul(*&I)     => *&I2<f32:8,1>   [!no-alias];
[#simd:v256]  *&I2 -> @scale(-1.0) => *&nI2<f32:8,1>  [!no-alias];
[#simd:v256]  *&I8 -> @add(*&nI2)  => *&Vraw<f32:8,1> [!no-alias];
[#simd:v256]  *&Vraw -> @scale(0.5) => *&Vhalf<f32:8,1> [!no-alias];

// Маска-ступенька точна только на целых, поэтому высоты округляем явно.
// Получается 0, 3, 6, 7, 8, 7, 6, 3.
*&Vhalf -> @cast.i32 -> @cast.f32 => *&V<f32:8,1>;

// --- Сетка: два внешних произведения ----------------------------------------
[#arena:0]  *&onerow<f32:1,8> -> @fill(1.0) => *&onerow;
[#arena:0]  *&onecol<f32:8,1> -> @fill(1.0) => *&onecol;

// VM[i,j] = V[i] — высота, размноженная по строке.
[#simd:v256]  *&V -> @mmul(*&onerow) => *&VM<f32:8,8>  [!no-alias, ?strict];
// JM[i,j] = j — номер столбца, размноженный по столбцу.
[#simd:v256]  *&onecol -> @mmul(*&J) => *&JM<f32:8,8>  [!no-alias, ?strict];

// D[i,j] = V[i] - j
[#simd:v256]  *&JM -> @scale(-1.0) => *&nJM<f32:8,8>  [!no-alias];
[#simd:v256]  *&VM -> @add(*&nJM)  => *&D<f32:8,8>    [!no-alias];

// --- Ступенька без ветвлений: relu(D) - relu(D-1) ---------------------------
[#arena:0]  *&minus1<f32:8,8> -> @fill(-1.0) => *&minus1;
[#simd:v256]  *&D -> @add(*&minus1) => *&Dm<f32:8,8>  [!no-alias];

[#simd:v256]  *&D  -> @relu => *&R0<f32:8,8>   [!no-alias];
[#simd:v256]  *&Dm -> @relu => *&R1<f32:8,8>   [!no-alias];
[#simd:v256]  *&R1 -> @scale(-1.0) => *&nR1<f32:8,8> [!no-alias];
[#simd:v256]  *&R0 -> @add(*&nR1)  => *&MASK<f32:8,8> [!no-alias];

// --- Маска в коды символов --------------------------------------------------
// 9608 - 32 = 9576
[#arena:0]  *&base<f32:8,8> -> @fill(32.0) => *&base;
[#simd:v256]  *&MASK -> @scale(9576.0) => *&span<f32:8,8>  [!no-alias];
[#simd:v256]  *&span -> @add(*&base)   => *&CHf<f32:8,8>   [!no-alias];

*&CHf -> @cast.i32 => *&CH<i32:8,8>;

// --- Вывод: восемь строк, потому что циклов в языке нет ----------------------
*&CH[0, ..] -> @emit.line => $e0;
*&CH[1, ..] -> @emit.line => $e1;
*&CH[2, ..] -> @emit.line => $e2;
*&CH[3, ..] -> @emit.line => $e3;
*&CH[4, ..] -> @emit.line => $e4;
*&CH[5, ..] -> @emit.line => $e5;
*&CH[6, ..] -> @emit.line => $e6;
*&CH[7, ..] -> @emit.line => $e7;

// Сумма маски — это общая площадь картинки: 0+3+6+7+8+7+6+3 = 40
*&MASK -> @reduce.add => $area;
