// Файл специально сломан: проверка восстановления лексера.
[#arena:0]  *&A<f32:1024,1024> -> @alloc => $r1;

// 1. литерал с прилипшим хвостом
[#simd:v256]  $r1 -> @scale(1024abc) => $r2;

// 2. сигил без тела
[#simd:v256]  $ -> @relu => $r3;

// 3. не-ASCII вне комментария
[^raw]  *&C[0, ..] -> @фильтр => $f0;

// 4. незакрытый блочный комментарий
/* дальше уже ничего не будет
