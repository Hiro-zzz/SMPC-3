// ============================================================================
//  ШАГ НЕЙРОСЕТИ В МИНИАТЮРЕ
// ============================================================================
//
// Всё, из чего складывается шаг языковой модели, кроме внимания по KV-кэшу:
// нормировка, линейный слой на весах q8_0, головы, поворот позиций, softmax
// по живой длине, активация и выбор следующего токена.
//
// Числа — не модель, а проверка. Экспоненты и синусы здесь свои, не из libm,
// и этот файл сверяется посимвольно и на хосте, и в ядре NablaOS: одна
// программа обязана давать одни и те же числа везде.

// --- Веса: 64 выхода по 32 входа, строка i — число i/64 ----------------------
// Квантуются в q8_0 — так же лежат веса настоящей модели.
[#arena:1]  *&Wf<f32:64,32> -> @alloc => $wf;
[#repeat:64, #index:i]  *&Wf[$i, ..] -> @fill($i) => *&Wf[$i, ..];
[#arena:1]  *&Wf -> @scale(0.015625) -> @cast.q8_0 => *&W<q8_0:64,32>;

// --- Вход: поворот единиц даёт разные числа без генератора случайных --------
[#arena:0]  *&x<f32:1,32> -> @fill(1.0) => *&x;
7 => $pos;
*&x -> @rope($pos, 10000.0) -> @rmsnorm(0.000001) => *&h<f32:1,32>;

// --- Линейный слой и головы: 64 выхода — это 4 головы по 16 ------------------
// @reshape не копирует: та же память, другая форма.
*&h -> @mmul.t(*&W) -> @reshape(4, 16) => $q;
$q -> @rope($pos, 1000000.0) => *&qr<f32:4,16>;

// --- Внимание смотрит только на живые позиции: первые $len -----------------
5 => $len;
*&qr -> @softmax($len) => *&p<f32:4,16>;

// --- Активация и выбор --------------------------------------------------------
*&qr -> @silu -> @sub(*&p) => *&a<f32:4,16>;
*&a -> @reshape(64) -> @argmax => $next;

*&h[0, ..] -> @emit.num => $n1;
*&p[0, ..] -> @emit.num => $n2;
*&a[3, ..] -> @emit.num => $n3;
*&a -> @reduce.add => $sum;
$sum -> @emit.num => $n4;
