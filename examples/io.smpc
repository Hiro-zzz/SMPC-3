// ============================================================================
//  ОБМЕН С ВНЕШНИМ МИРОМ: @load и @store
// ============================================================================
//
// До сих пор данные попадали в программу только литералами, а наружу уходили
// только печатью. @load и @store закрывают этот пробел: тензор читается из
// файла и пишется в файл сырыми байтами, без заголовка.
//
// Имени файла в исходнике нет и не будет — строкового типа в языке тоже нет.
// Программа знает имя ТЕНЗОРА, а путь приезжает из командной строки:
//
//   smpc3 run examples/io.smpc --out V=v.bin --in W=v.bin
//
// Вход и выход разведены по направлению, поэтому одно и то же имя файла может
// стоять в обоих: здесь программа сама себе и пишет, и читает.

// --- Считаем и выгружаем ----------------------------------------------------
[#arena:0]  *&N<i32:8> -> @alloc => *&N;
[#repeat:8, #index:i]  $i => *&N[$i];

// Индекс развёртки — целое, а обмениваться с Python удобнее в f32. Приведение
// пишется явно: молча округлять или расширять язык не станет.
[#arena:0]  *&V<f32:8> -> @alloc => *&V;
*&N -> @cast.f32 => *&V;

// @store — такая же свёртка, как @emit: съедает тензор, отдаёт число. Только
// не выведенных элементов, а записанных байт: 8 * f32 = 32.
*&V -> @store => $put;
$put -> @emit.dec => $shown;

// --- Читаем обратно ---------------------------------------------------------
// W объявлен отдельно и той же формы. Размер обязан совпасть байт в байт:
// заголовка у файла нет, и подогнать одно под другое не по чему.
[#arena:0]  *&W<f32:8> -> @load => *&W;

// Сумма 0+1+...+7 = 28, если файл доехал целиком.
*&W -> @reduce.add => $sum;
$sum -> @emit.num => $shown2;

// --- Чего здесь нет ---------------------------------------------------------
// @load обязан быть первой стадией: привязка идёт по имени тензора, а после
// любой считающей стадии остаётся безымянный временный буфер. Вот так нельзя,
// и компилятор скажет это на сборке, а не в рантайме:
//
//   *&W -> @relu -> @store => $n;
//
// Срез с шагом тоже нельзя — записывать его пришлось бы по кускам:
//
//   *&M[.., 1] -> @store => $n;      // столбец идёт с шагом
//
// Тип элемента остаётся на совести автора. f32:8 и f64:4 занимают одинаковые
// 32 байта, и различить их по содержимому нечем — ровно как с [!no-alias],
// это обещание, а не проверка.
