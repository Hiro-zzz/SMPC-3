// ============================================================================
//  HELLO WORLD, КОТОРЫЙ ВЫЧИСЛЯЕТСЯ
// ============================================================================
//
// В hello.smpc коды символов записаны руками — это не программа, а таблица.
// Здесь текст получается арифметикой: в памяти лежит шифровка, а строка
// восстанавливается одним векторным сложением.
//
// Шифр Цезаря со сдвигом 3: в тензоре хранится код минус 3. Одно сложение по
// всей длине — и в потоке появляется «Hello, World!».
//
// Это и есть ответ на вопрос «как выглядит Hello World на калькуляторе»:
// калькулятор не хранит буквы, он их считает.

[#arena:0]  *&SECRET<f32:13> -> @alloc => $s;

// 'H'-3=69, 'e'-3=98, 'l'-3=105 ...
 69.0 => *&SECRET[0];    // H
 98.0 => *&SECRET[1];    // e
105.0 => *&SECRET[2];    // l
105.0 => *&SECRET[3];    // l
108.0 => *&SECRET[4];    // o
 41.0 => *&SECRET[5];    // ,
 29.0 => *&SECRET[6];    // пробел
 84.0 => *&SECRET[7];    // W
108.0 => *&SECRET[8];    // o
111.0 => *&SECRET[9];    // r
105.0 => *&SECRET[10];   // l
 97.0 => *&SECRET[11];   // d
 30.0 => *&SECRET[12];   // !

// --- Расшифровка: одно векторное сложение ------------------------------------
[#arena:0]  *&KEY<f32:13> -> @fill(3.0) => *&KEY;
[#simd:v256]  *&SECRET -> @add(*&KEY) => *&PLAIN<f32:13>  [!no-alias, ?strict];

// @emit.text печатает целые, приведение обязано быть явным.
*&PLAIN -> @cast.i32 => *&OUT<i32:13>;
*&OUT -> @emit.line => $n;

// --- Проверка без глаз --------------------------------------------------------
// Контрольная сумма «Hello, World!» равна 1129. Если расшифровка сломается,
// это увидит не человек, а число.
*&OUT -> @reduce.add => $checksum;

// --- Та же строка, но заглавными ---------------------------------------------
// Разница между 'a' и 'A' — ровно 32. Маска «это строчная буква» строится
// ступенькой из relu, как в bars.smpc, только по одному порогу:
//
//     lower[i] = 1, если код >= 97
//
// Для кодов из ASCII шаг ровно один, поэтому relu(x) - relu(x-1) даёт 0 или 1.
[#arena:0]  *&thresh<f32:13> -> @fill(-96.0) => *&thresh;
[#simd:v256]  *&PLAIN -> @add(*&thresh) => *&over<f32:13>  [!no-alias];

[#simd:v256]  *&over -> @relu => *&r0<f32:13>  [!no-alias];
[#arena:0]  *&minus1<f32:13> -> @fill(-1.0) => *&minus1;
[#simd:v256]  *&over -> @add(*&minus1) => *&over1<f32:13>  [!no-alias];
[#simd:v256]  *&over1 -> @relu => *&r1<f32:13>  [!no-alias];
[#simd:v256]  *&r1 -> @scale(-1.0) => *&nr1<f32:13>  [!no-alias];
[#simd:v256]  *&r0 -> @add(*&nr1) => *&islower<f32:13>  [!no-alias];

// Вычитаем 32 там, где маска единица.
[#simd:v256]  *&islower -> @scale(-32.0) => *&shift<f32:13>  [!no-alias];
[#simd:v256]  *&PLAIN -> @add(*&shift) => *&UPPERf<f32:13>   [!no-alias];

*&UPPERf -> @cast.i32 => *&UPPER<i32:13>;
*&UPPER -> @emit.line => $n2;
