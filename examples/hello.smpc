// ============================================================================
//  HELLO WORLD
// ============================================================================
//
// Честный ответ: в этом языке нет ни строк, ни символьного типа, ни
// ввода-вывода. Это DSL для перемножения матриц, а не для разговоров с
// пользователем. Классический Hello World здесь буквально невыразим.
//
// Ближайшее, что имеет смысл: сложить строку из кодов ASCII в тензор i32 и
// показать её. Рантайм печатает содержимое именованных тензоров, так что
// "вывод" — это дамп чисел, а не текст.
//
//   smpc3 run examples/hello.smpc
//
// Ожидаемое:
//   *&HELLO <i32:13> [72, 101, 108, 108, 111, 44, 32, 87, ... (+5)]
//   $len    <i32>    13
//   $sum    <i32>    1129

[#arena:0]  *&HELLO<i32:13> -> @alloc => $msg;

// Поэлементная запись — единственный способ задать разные значения:
// @fill кладёт одно и то же во все элементы.
72  => *&HELLO[0];    // H
101 => *&HELLO[1];    // e
108 => *&HELLO[2];    // l
108 => *&HELLO[3];    // l
111 => *&HELLO[4];    // o
44  => *&HELLO[5];    // ,
32  => *&HELLO[6];    // (пробел)
87  => *&HELLO[7];    // W
111 => *&HELLO[8];    // o
114 => *&HELLO[9];    // r
108 => *&HELLO[10];   // l
100 => *&HELLO[11];   // d
33  => *&HELLO[12];   // !

// Длину считаем как сумму единиц: отдельной операции @len здесь нет,
// а форма тензора и так известна компилятору.
[#arena:0]  *&ONES<i32:13> -> @fill(1) => *&ONES;
*&ONES -> @reduce.add => $len;

// Контрольная сумма сообщения. Кому-то это Hello World, кому-то — 1129.
*&HELLO -> @reduce.add => $sum;

// Самый частый символ имеет наибольший код? Нет, самый большой код у 'r'.
*&HELLO -> @reduce.max => $peak;
