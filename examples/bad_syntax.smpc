// Синтаксически битый файл: проверка панического восстановления.
// Каждая инструкция ниже обязана дать РОВНО одну претензию,
// а корректные строки между ними — уцелеть.

[#arena:0]  *&A<f32:1024,1024> -> @alloc => $r1;

// 1. приёмник-литерал
[#simd:v256]  $r1 -> @scale(2.0) => 42;

// 2. суффикс встал до тела
[!no-alias]  $r1 -> @relu => $r2;

// 3. несуществующий тип
*&B<f16:512,512> -> @alloc => $r3;

// 4. ось нулевого размера
*&C<f32:1024,0> -> @alloc => $r4;

// 5. префикс уехал в хвост
$r1 -> @relu => $r5  [#simd:v256];

// 6. забыта точка с запятой
$r1 -> @relu => $r6

// 7. эта инструкция корректна и обязана дойти до дерева
[^raw]  *&A[0, ..] -> @reduce.add => $f0  [~flush-to-zero];

// 8. неровная таблица: во второй строке одно число, в первой — два
[[1, 2], [3]] => *&D<f32:2,2>;

// 9. литерал-таблица корректен и тоже доходит до дерева
[[1, 2], [3, 4]] => *&E<f32:2,2>;
