// ============================================================================
//  КАЛЬКУЛЯТОР
// ============================================================================
//
// Язык считал матрицы и не умел сложить два числа: «2 + 2» было тремя
// инструкциями — объявить тензор, записать элементы, свернуть. Теперь числа
// идут по конвейеру так же, как тензоры, а таблица чисел пишется прямо в
// тексте.
//
// Правило типов одно: у числа в тексте своего типа нет, его даёт сосед.
// 23 рядом с f32 — это 23.0, рядом с i32 — 23. Два литерала — f32, если хоть
// в одном есть точка, иначе i32. Неявных приведений между i32 и f32 как не
// было, так и нет.

// --- Числа -------------------------------------------------------------------
17 -> @mul(23) => $product;              // 391, i32
100 -> @sub(37) => $difference;          // 63
7 -> @div(2) => $int_quotient;           // 3: целое деление отбрасывает дробь
7.0 -> @div(2) => $quotient;             // 3.5: 2 рядом с f32 — это 2.0
2 -> @sqrt => $root2;                    // корню нужна дробь, 2 становится 2.0
-12 -> @abs => $modulus;                 // 12

// Результат одной инструкции — операнд следующей.
$quotient -> @mul($quotient) -> @add(1.75) => $sq;    // 3.5^2 + 1.75 = 14

// --- Таблицы чисел -----------------------------------------------------------
[4, 8, 15, 16, 23, 42] => *&xs<f32:6>;   // целые числа в f32 — приёмник решает
*&xs -> @reduce.add -> @div(6) => $mean;  // 18
*&xs -> @reduce.max => $top;              // 42

[[1, 2, 3],
 [4, 5, 6]] => *&M<f32:2,3>;
[1, 0, -1] => *&v<f32:3>;

// Матрица на вектор: вектор — столбец 3x1.
*&v -> @reshape(3, 1) => $col;
*&M -> @mmul($col) => *&Mv<f32:2,1>;     // [1 - 3, 4 - 6] = [-2, -2]

// Длина вектора: корень из скалярного произведения с самим собой.
*&v -> @mul(*&v) -> @reduce.add -> @sqrt => $norm;   // sqrt(2)

// Поэлементное деление — только в дробях.
[1.0, 2, 3] -> @div(*&v) => *&bad_idea<f32:3>;       // 1/0 = inf, это IEEE

// Столбец задаётся литералом по шагам приёмника.
[#arena:0]  *&T<i32:3,2> -> @alloc => *&T;
[10, 20, 30] => *&T[.., 1];

// Число — заполнитель и множитель: регистр вместо литерала.
[#arena:0]  *&H<f32:4> -> @fill($mean) => *&H;
*&H -> @scale($quotient) => *&H2<f32:4>;             // 18 * 3.5 = 63
