// Развёртка, заданная неверно. Все претензии здесь — E0310, и все они
// высказываются до семантики: разворачивать нечего, значит и проверять нечего.

[#arena:0]  *&M<f32:4,8> -> @alloc => *&M;

// 1. ноль повторов — инструкция, которую попросили не исполнять ни разу
[#repeat:0, #index:i]  *&M[$i, ..] -> @abs => *&M[$i, ..];

// 2. повторов больше потолка: это развёртка, каждый повтор стоит инструкций
[#repeat:9999, #index:i]  *&M[$i, ..] -> @abs => *&M[$i, ..];

// 3. #index без #repeat — нумеровать нечего
[#index:i]  *&M -> @abs => *&M;

// 4. число повторов обязано быть известно на компиляции
[#repeat:v256, #index:i]  *&M[$i, ..] -> @abs => *&M[$i, ..];

// 5. объявление внутри развёртки: восемь копий объявили бы одно имя восемь раз
[#repeat:8, #index:i]  *&M[$i, ..] -> @abs => *&BAD<f32:8>;
