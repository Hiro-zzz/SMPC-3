// Ошибки калькулятора: по одной претензии на строку, все — на компиляции.

[1.0, 2.0] => *&f<f32:2>;
[1, 2]     => *&n<i32:2>;

// 1. дробь в целом типе: литерал берёт тип соседа, а дробь в i32 не лезет
*&n -> @reduce.add -> @mul(2.5) => $a;

// 2. число и тензор в одной операции
3.0 -> @add(*&f) => $b;

// 3. целые тензоры не делятся
*&n -> @div(*&n) => *&q<i32:2>;

// 4. регистр i32 — уже тип, корень его молча в дробь не превратит
*&n -> @reduce.add -> @sqrt => $c;

// 5. литерал не той формы, что приёмник
[1, 2, 3] => *&f2<f32:2>;

// 6. число, которое не помещается в i32
3000000000 -> @add(1) => $d;

// 7. литерал тензора — только источник
*&f -> @add([1.0, 2.0]) => *&g<f32:2>;
