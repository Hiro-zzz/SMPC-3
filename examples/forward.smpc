// Прямой проход двухслойной сети. Все числа подобраны так, чтобы результат
// считался в уме.
//
//   x  = 1.0,  форма [1,4]
//   W1 = 0.5,  форма [4,8]   ->  h = 4 * (1.0 * 0.5) = 2.0
//   relu(2.0) = 2.0
//   W2 = 0.25, форма [8,3]   ->  y = 8 * (2.0 * 0.25) = 4.0
//   sum(y) = 3 * 4.0 = 12.0
//   max(y) = 4.0

// Веса лежат в отдельной арене: они живут всю программу, а активации —
// нет, и мешать их в одном блоке незачем.
[#arena:1]  *&W1<f32:4,8> -> @fill(0.5)  => *&W1;
[#arena:1]  *&W2<f32:8,3> -> @fill(0.25) => *&W2;

[#arena:0]  *&x<f32:1,4>  -> @fill(1.0)  => *&x;

// Слой 1: x @ W1 -> relu
[#simd:v256]  *&x -> @mmul(*&W1) => *&h<f32:1,8>  [!no-alias, ?strict];
[#simd:v256]  *&h -> @relu       => *&a<f32:1,8>  [!no-alias];

// Слой 2
[#simd:v256]  *&a -> @mmul(*&W2) => *&y<f32:1,3>  [!no-alias, ?strict];

// Сводки
*&y -> @reduce.add => $sum;
*&y -> @reduce.max => $peak;

// Транспонированный вид весов — без копии, только перестановка шагов;
// @pack материализует его в плотный буфер.
*&W1 -> @transpose -> @pack => *&W1T<f32:8,4>;

$sum  -> @cast.f64 => $sum64;
$peak -> @cast.f64 => $peak64;
