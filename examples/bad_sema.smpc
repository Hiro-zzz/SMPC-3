// Синтаксис везде корректен. Претензии — только семантические.

[#arena:0]  *&A<f32:1024,1024>  -> @alloc => $r1;
[#arena:0]  *&B<f32:512,512>    -> @alloc => $r2;
[#arena:0]  *&W<f32:1023,1023>  -> @alloc => $rw;

// 1. K не сходится: у A внутренняя ось 1024, у B — 512
[#simd:v512]  $r1 -> @mmul($r2) => *&C<f32:1024,512>  [!no-alias];

// 2. ложное обещание [!no-alias]: A стоит по обе стороны '=>'
[#simd:v256]  $r1 -> @relu => *&A  [!no-alias];

// 3. столбец матрицы — срез с шагом, а ^raw не умеет шаг
[^raw]  *&A[.., 0] -> @reduce.add => $f1;

// 4. срез с нечётной строки сбивает выравнивание под v256
[#simd:v256]  *&W[1, ..] -> @relu => *&V<f32:1023>;

// 5. опечатка в имени операции
$r1 -> @realu => $f2;

// 6. опечатка в имени атрибута
$r1 -> @relu => $r3  [~flush-to-zerro];

// 7. чтение необъявленного тензора
*&NOPE -> @relu => $r4;

// 8. broadcast отсутствует намеренно
$r1 -> @add($r2) => $r5;
