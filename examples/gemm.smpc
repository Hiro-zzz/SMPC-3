// Проверяемая вручную арифметика.
//
//   A = 2.0 всюду, форма [2,3]
//   B = 3.0 всюду, форма [3,2]
//   C = A x B  ->  каждый элемент = 3 * (2*3) = 18
//   D = relu(C - ничего не отсекает) * 0.5 = 9
//   s = сумма D по всем 4 элементам = 36

[#arena:0]  *&A<f32:2,3> -> @fill(2.0) => *&A;
[#arena:0]  *&B<f32:3,2> -> @fill(3.0) => *&B;

[#simd:v256]  *&A -> @mmul(*&B) => *&C<f32:2,2>  [!no-alias];

*&C -> @relu -> @scale(0.5) => *&D<f32:2,2>;
*&D -> @reduce.add => $total;

// Транспозиция без копии: шаги переставляются, память та же.
*&A -> @transpose -> @pack => *&AT<f32:3,2>;

// Сумма по столбцу — срез с шагом, компилятор про шаг знает.
*&C[.., 0] -> @reduce.add => $col0;

$total -> @cast.f64 => $out;
$col0  -> @cast.f64 => $out2;
